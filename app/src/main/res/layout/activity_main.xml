<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/white">

    <LinearLayout
        android:paddingBottom="@dimen/r2dp50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">


        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/r2dp10"
            android:paddingBottom="@dimen/r2dp10"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@drawable/custom_divider"
                android:gravity="center_vertical"
                android:showDividers="middle|beginning|end">

                <ImageView
                    android:id="@+id/image1"
                    android:layout_width="@dimen/r2dp160"
                    android:layout_height="@dimen/r2dp90"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tools_preview" />

                <com.yoake.widgets.image.R2ImageView2
                    android:layout_width="@dimen/r2dp80"
                    android:layout_height="@dimen/r2dp80"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tools_preview"
                    app:r2_border_color="@color/deep_sky_blue"
                    app:r2_border_width="@dimen/r2dp2"
                    app:r2_is_circle="true" />

                <com.yoake.widgets.progress.R2CountDownProgressView
                    android:id="@+id/testCountTimeProgressView"
                    android:layout_width="@dimen/r2dp60"
                    android:layout_height="@dimen/r2dp60"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:r2cd_backgroundColorCenter="@color/back"
                    app:r2cd_borderBottomColor="@color/back"
                    app:r2cd_borderDrawColor="@color/orange"

                    app:r2cd_borderWidth="@dimen/r2dp3"
                    app:r2cd_countTime="6000"
                    app:r2cd_markBallColor="@color/red"
                    app:r2cd_markBallWidth="@dimen/r2dp6"
                    app:r2cd_textStyle="second"

                    app:r2cd_titleCenterSize="@dimen/r2dp18"
                    app:r2cd_titleCenterText="跳过" />


                <com.yoake.widgets.image.R2ImageView2
                    android:layout_width="@dimen/r2dp80"
                    android:layout_height="@dimen/r2dp80"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tools_preview"
                    app:r2_border_color="@color/red"
                    app:r2_border_width="@dimen/r2dp1"
                    app:r2_corner_radius="@dimen/r2dp10" />

                <com.yoake.widgets.image.R2ImageView2
                    android:layout_width="@dimen/r2dp80"
                    android:layout_height="@dimen/r2dp80"
                    android:layout_margin="@dimen/r2dp8"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tools_preview"
                    app:r2_corner_radius="@dimen/r2dp10"
                    app:r2_shadowAlpha="1.0"
                    app:r2_shadowElevation="@dimen/r2dp8" />

                <com.yoake.widgets.layout.R2RelativeLayout
                    android:layout_width="@dimen/r2dp80"
                    android:layout_height="@dimen/r2dp80"
                    app:r2_borderColor="@color/yellow"
                    app:r2_borderWidth="@dimen/r2dp2"

                    app:r2_radius="@dimen/r2dp10">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tools_preview" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:background="#A0000000"
                        android:gravity="center"
                        android:padding="@dimen/r2dp4"
                        android:text="犬夜叉"
                        android:textColor="@color/white"
                        android:textSize="@dimen/r2dp16" />
                </com.yoake.widgets.layout.R2RelativeLayout>


                <com.yoake.widgets.layout.R2ConstraintLayout
                    android:layout_width="@dimen/r2dp160"
                    android:layout_height="@dimen/r2dp90"
                    android:layout_margin="@dimen/r2dp8"
                    android:background="@color/white"
                    app:r2_radius="@dimen/r2dp6"
                    app:r2_shadowAlpha="1.0"
                    app:r2_shadowElevation="@dimen/r2dp8">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tools_preview" />


                </com.yoake.widgets.layout.R2ConstraintLayout>

                <com.yoake.widgets.button.R2Button
                    android:layout_width="@dimen/r2dp80"
                    android:layout_height="@dimen/r2dp40"
                    android:background="@color/back"
                    android:text="按钮"
                    android:textColor="@color/yellow"
                    android:textSize="@dimen/r2dp16"
                    app:r2_borderColor="@color/yellow"
                    app:r2_borderWidth="@dimen/r2dp1"
                    app:r2_radius="@dimen/r2dp20" />
            </LinearLayout>


        </HorizontalScrollView>

        <com.yoake.widgets.text.R2ReadMoreTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/r2dp10"
            android:text="@string/tools_preview_text"
            app:r2readLessText="收起"
            app:r2readLessTextColor="@color/orange"
            app:r2readMoreMaxLines="2"
            app:r2readMoreText="展开"
            app:r2readMoreTextColor="@color/red" />

        <com.yoake.widgets.layout.R2EdgeTransparentLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/r2dp10"
            app:r2_edge_width="@dimen/r2dp10">

            <com.yoake.widgets.image.R2ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/tools_preview" />
        </com.yoake.widgets.layout.R2EdgeTransparentLayout>

        <com.yoake.widgets.text.R2MarqueeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/r2dp10"
            android:background="@color/back"
            android:padding="@dimen/r2dp10"
            android:text="@string/tools_preview_text"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/infoTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/r2dp10"
            android:background="@color/back"
            android:padding="@dimen/r2dp10"
            android:text="info"
            android:textColor="@color/white" />

        <GridLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:padding="@dimen/r2dp10"

            android:useDefaultMargins="true">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:text="仿IOS对话框" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:text="" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:text="三方登录" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:text="定位和权限" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:text="保存网络图片" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:text="Loading" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:text="Popup" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:text="VIDEO_PLAYER" />

        </GridLayout>

        <com.yoake.widgets.poster.PosterView
            android:id="@+id/poster_view"
            android:layout_width="match_parent"
            android:layout_marginEnd="@dimen/r2dp10"
            android:layout_marginStart="@dimen/r2dp10"
            android:layout_height="180dp" />
    </LinearLayout>
</ScrollView>